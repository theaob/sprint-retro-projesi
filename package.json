{
  "name": "sprint-retro",
  "version": "4.6.0",
  "description": "Sprint Retrospective Web Application",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"npx vite\"",
    "dev:server": "node server/index.js",
    "dev:client": "npx vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "htm": "^3.1.1",
    "preact": "^10.29.8",
    "uuid": "^9.0.0",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "concurrently": "^8.2.0",
    "supertest": "^7.2.2",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
